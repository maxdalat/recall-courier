{
  "mcpServers": {
    "anki": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.js"],
      "env": {
        "RECALL_COURIER_URL": "${user_config.anki_connect_url}",
        "RECALL_COURIER_API_KEY": "${user_config.anki_connect_api_key}",
        "RECALL_COURIER_AUTO_LAUNCH": "${user_config.auto_launch}"
      }
    }
  }
}
